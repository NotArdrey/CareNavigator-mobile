    {
        "title":  "Test Case TC_BOOKING_001",
        "blocks":  [
                       {
                           "h2":  "Reserve an In-Person Consultation from a Published Slot"
                       },
                       {
                           "p":  "Related scenario: TS-03. Case type: Positive / happy path."
                       },
                       {
                           "h3":  "Preconditions"
                       },
                       {
                           "steps":  [
                                         "An active patient is signed in with a complete profile.",
                                         "A verified, operating hospital has an eligible doctor.",
                                         "An unoccupied in-person slot is at least 24 hours away."
                                     ]
                       },
                       {
                           "h3":  "Test Data"
                       },
                       {
                           "p":  "Hospital: verified and operating fixture. Clinician: eligible doctor. Concern: Recurring headache for two days. Slot: 48 hours ahead."
                       },
                       {
                           "h3":  "Test Steps"
                       },
                       {
                           "steps":  [
                                         "Open Patient \u003e Appointments.",
                                         "Select Reserve consultation.",
                                         "Choose the hospital, clinician, and In person care mode.",
                                         "Enter the primary care concern.",
                                         "Choose a published date and time, then select Reserve consultation."
                                     ]
                       },
                       {
                           "h3":  "Expected Results"
                       },
                       {
                           "steps":  [
                                         "One reservation is created for the signed-in patient.",
                                         "It appears with the selected hospital, doctor, mode, and time.",
                                         "Its status and time match the server record.",
                                         "The occupied slot is no longer offered."
                                     ]
                       },
                       {
                           "source":  "Execution record: Actual result, execution date, tester, and pass/fail outcome were not supplied in Activity 1. Source S23."
                       }
                   ]
    },
    {
        "title":  "Test Case TC_BOOKING_002",
        "blocks":  [
                       {
                           "h2":  "Reservation Blocked When No Qualifying Slot Is Available"
                       },
                       {
                           "p":  "Related scenario: TS-03. Case type: Negative / error path."
                       },
                       {
                           "h3":  "Preconditions"
                       },
                       {
                           "steps":  [
                                         "An active patient is signed in.",
                                         "The doctor has no qualifying unoccupied slot in the next 30 days.",
                                         "No reservation exists for this attempt."
                                     ]
                       },
                       {
                           "h3":  "Test Data"
                       },
                       {
                           "p":  "Clinician: no qualifying future slots. Search window: next 30 days. Minimum lead time: 24 hours (boundary/edge data)."
                       },
                       {
                           "h3":  "Test Steps"
                       },
                       {
                           "steps":  [
                                         "Open Patient \u003e Appointments and select Reserve consultation.",
                                         "Select the clinician fixture with no qualifying slots.",
                                         "Select In person care mode.",
                                         "Review the availability area and the submission control."
                                     ]
                       },
                       {
                           "h3":  "Expected Results"
                       },
                       {
                           "steps":  [
                                         "No date or time can be selected.",
                                         "The no-slot message states the 24-hour notice rule.",
                                         "Reserve consultation is disabled.",
                                         "No consultation or duplicate record is created."
                                     ]
                       },
                       {
                           "source":  "Execution record: Actual result, execution date, tester, and pass/fail outcome were not supplied in Activity 1. Source S23."
                       }
