# Client/public build configuration only; copy these three values to a public JSON build file.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
APP_BASE_URL=https://YOUR_APPLICATION

# Server/deployment only. Keep real values in ignored env or the server secret store.
SUPABASE_PROJECT_ID=YOUR_PROJECT_REFERENCE
SUPABASE_ACCESS_TOKEN=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=
SMTP_TEST_RECIPIENT=
NOTIFICATION_DISPATCH_TOKEN=
ADMIN_BOOTSTRAP_TOKEN=
