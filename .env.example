SUPABASE_PROJECT_NAME=CareNavigator
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_ACCESS_TOKEN=your-personal-access-token
SUPABASE_DB_PASSWORD=your-database-password
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
ADMIN_BOOTSTRAP_TOKEN=generate-a-long-random-one-time-token
NOTIFICATION_DISPATCH_TOKEN=generate-a-long-random-scheduler-token

# Optional email delivery. Use a provider-specific app password or SMTP
# credential, never the mailbox's normal sign-in password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=sender@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
NOTIFICATION_FROM_EMAIL=CareNavigator PH <sender@gmail.com>
APP_BASE_URL=https://your-carenavigator-domain.example
