[
    {
        "title":  "Functional Testing",
        "blocks":  [
                       {
                           "p":  "The test design follows the existing Activity 1 CareNavigator PH Test Scenarios and Test Cases document. Its 15 scenarios identify the functions to verify. Four detailed cases define positive and negative checks for TS-02 (sign-in) and TS-03 (in-person reservation). The original scenario and test-case identifiers are retained. [S23]"
                       },
                       {
                           "p":  "Activity 1 supplies expected outcomes but no actual results, execution dates, or pass/fail records. The cases below are therefore documented test designs. The recorded implementation evidence appears separately under Evaluation and Recorded Verification and is not assigned as a result for these four cases."
                       },
                       {
                           "h2":  "Test Scenarios TS-01 to TS-08"
                       },
                       {
                           "table":  {
                                         "font":  11,
                                         "rows":  [
                                                      [
                                                          "TS-01",
                                                          "Verify that a patient can register with valid identity information and complete email verification."
                                                      ],
                                                      [
                                                          "TS-02",
                                                          "Verify that an active user can sign in with valid credentials."
                                                      ],
                                                      [
                                                          "TS-03",
                                                          "Verify that a patient can reserve an available consultation slot."
                                                      ],
                                                      [
                                                          "TS-04",
                                                          "Verify that a public user can search verified, operating hospitals and doctors and view accurate directory and map details."
                                                      ],
                                                      [
                                                          "TS-05",
                                                          "Verify that an authorized doctor can complete a consultation and save clinical checkup and prescription information for the correct patient."
                                                      ],
                                                      [
                                                          "TS-06",
                                                          "Verify that route guards and Row Level Security prevent a user from accessing another user\u0027s or hospital\u0027s protected clinical data."
                                                      ],
                                                      [
                                                          "TS-07",
                                                          "Verify that a guest can submit a consultation request, complete email OTP verification, and enter the authorized review workflow."
                                                      ],
                                                      [
                                                          "TS-08",
                                                          "Verify that the care assistant returns preliminary symptom guidance and escalates deterministic emergency warning signs safely."
                                                      ]
                                                  ],
